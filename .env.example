# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=mini_ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- JWT ---
# Signing key for HS256 — MUST be at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-32-byte-string
JWT_ISSUER=MiniEcommerce
JWT_AUDIENCE=MiniEcommerce

# --- CORS ---
# Public origin of the web app (what the browser sees).
CORS_ORIGIN=http://localhost

# --- Optional ---
# The production nginx proxy serves /api same-origin, so the SPA uses relative
# URLs by default. Only set this if you build the frontend against a separate
# API origin.
# VITE_API_URL=http://localhost:5000